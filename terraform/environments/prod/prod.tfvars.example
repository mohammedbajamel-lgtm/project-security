# ====================
# CloudSec AI — Production Environment
# ====================
# Copy this file to prod.tfvars and fill in real values.
# NEVER commit prod.tfvars with real secrets.

environment        = "prod"
account_id         = "<PROD_ACCOUNT_ID>"
security_account_id = "<SECURITY_ACCOUNT_ID>"
region             = "us-east-1"

# Cross-account role ARNs
read_role_arn         = "arn:aws:iam::<WORKLOAD_ACCOUNT_ID>:role/CloudSecAI-ReadRole"
remediation_role_arn  = "arn:aws:iam::<WORKLOAD_ACCOUNT_ID>:role/CloudSecAI-RemediationRole"

# Tags
project      = "cloudsec-ai"
managed_by   = "terraform"
cost_center  = "security"

# Evidence bucket — MUST be true in prod (Object Lock for forensic integrity)
evidence_bucket_object_lock = true

# Budget (monthly, USD)
budget_monthly_limit = 2000.0

# Approval (human-in-the-loop)
approval_sns_topic_arn = "arn:aws:sns:<REGION>:<SECURITY_ACCOUNT_ID>:cloudsec-prod-escalations"
