# CloudSec AI - Dev Environment Variables (example)
# Copy to dev.tfvars and fill in real values. dev.tfvars is gitignored.

environment = "dev"
region      = "us-east-1"
cost_center = "security"

# ---- Account IDs ----
# For single-account dev, security_account_id = workload_account_id.
security_account_id = "<YOUR_ACCOUNT_ID>"
workload_account_id = "<YOUR_ACCOUNT_ID>"

# ---- Provider assume-role ----
# MUST be an IAM role ARN (not an IAM user ARN). Regex-validated in
# environments/common/variables.tf.
security_account_role_arn = "arn:aws:iam::<YOUR_ACCOUNT_ID>:role/cloudsec-dev-terraform-deploy"
workload_account_role_arn = "arn:aws:iam::<YOUR_ACCOUNT_ID>:role/cloudsec-dev-terraform-deploy"

# ---- Principals allowed to assume CloudSec AI roles ----
allowed_terraform_principal_arn     = "arn:aws:iam::<YOUR_ACCOUNT_ID>:user/<YOUR_DEV_USER>"
allowed_security_admin_principal_arn = "arn:aws:iam::<YOUR_ACCOUNT_ID>:user/<YOUR_DEV_USER>"

# ---- Project ----
project_name = "cloudsec-ai"
created_by   = "cloudsec-platform"
