# ====================
# CloudSec AI — Dev Environment
# ====================
# Copy this file to dev.tfvars and fill in real values.
# NEVER commit dev.tfvars with real secrets.

environment        = "dev"
account_id         = "<DEV_ACCOUNT_ID>"
security_account_id = "<SECURITY_ACCOUNT_ID>"
region             = "us-east-1"

# Cross-account role ARNs
read_role_arn         = "arn:aws:iam::<WORKLOAD_ACCOUNT_ID>:role/CloudSecAI-ReadRole"
remediation_role_arn  = "arn:aws:iam::<WORKLOAD_ACCOUNT_ID>:role/CloudSecAI-RemediationRole"

# Tags
project      = "cloudsec-ai"
managed_by   = "terraform"
cost_center  = "security"

# Evidence bucket
evidence_bucket_object_lock = false   # Set true only in prod

# Budget (monthly, USD)
budget_monthly_limit = 100.0

# Approval (human-in-the-loop)
approval_sns_topic_arn = "arn:aws:sns:<REGION>:<SECURITY_ACCOUNT_ID>:cloudsec-dev-escalations"
